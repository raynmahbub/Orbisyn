{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbisyn",
  "version": "0.1.0-dev.0",
  "identifier": "org.orbisyn.store",
  "build": {
    "beforeDevCommand": "npm run dev --workspace @orbisyn/web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --workspace @orbisyn/web",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Orbisyn",
        "width": 1280,
        "height": 820,
        "minWidth": 840,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost https: http:; img-src 'self' asset: http://asset.localhost data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "A unified, verifiable app store for open-source software.",
    "longDescription": "Discover, verify and track open-source software across upstream sources.",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
