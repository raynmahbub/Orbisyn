# Orbisyn — local development environment.
#
# Copy to .env and adjust. Never commit .env.
# Every variable below is read by services/gateway/src/config.ts; anything not
# listed here is not configuration.

# --- Runtime -----------------------------------------------------------------
# development | test | production
NODE_ENV=development
# debug | info | warn | error | silent
LOG_LEVEL=debug

# --- Gateway service ---------------------------------------------------------
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8787
# Comma-separated list of allowed browser origins. Use "*" only locally.
GATEWAY_CORS_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost,tauri://localhost,http://tauri.localhost,https://tauri.localhost
# Requests per window per client address; 0 disables the limiter.
GATEWAY_RATE_LIMIT_MAX=120
GATEWAY_RATE_LIMIT_WINDOW_MS=60000
# Optional path to a built client. Defaults to apps/web/dist when it exists.
ORBISYN_WEB_ROOT=
# Durable gateway state. Relative paths resolve from the repository root.
ORBISYN_STORE_FILE=./var/orbisyn/store.json
# Opaque E2E-encrypted sync snapshots; Orbisyn never receives the AES key.
ORBISYN_SYNC_VAULT_FILE=./var/orbisyn/sync-vaults.json

# --- Outbound HTTP (upstream source providers) -------------------------------
# Optional tokens. They raise the anonymous rate limit and unlock private
# repository resolution; without them the gateway still works anonymously.
GITHUB_TOKEN=
GITLAB_TOKEN=
# host=token pairs for self-hosted forges, e.g.
#   forgejo.example.org=abc123,codeberg.org=def456
ORBISYN_FORGE_TOKENS=
# Additional self-hosted forge hosts to probe, e.g. forgejo.example.org
ORBISYN_FORGE_HOSTS=
GATEWAY_HTTP_TIMEOUT_MS=10000

# --- Cache -------------------------------------------------------------------
GATEWAY_CACHE_TTL_SECONDS=300
GATEWAY_CACHE_MAX_ENTRIES=2000

# --- Build -------------------------------------------------------------------
# Reported by /api/health as the running version.
ORBISYN_VERSION=0.1.0-dev.0
