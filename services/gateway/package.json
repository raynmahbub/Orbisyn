{
  "name": "@orbisyn/gateway",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "Orbisyn gateway: HTTP API, resolution orchestration, caching and static client delivery.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/server.js --sourcemap",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/sensible": "6.0.6",
    "@fastify/static": "10.1.5",
    "@orbisyn/contracts": "0.1.0-dev.0",
    "@orbisyn/core": "0.1.0-dev.0",
    "@orbisyn/osp": "0.1.0-dev.0",
    "@orbisyn/providers": "0.1.0-dev.0",
    "fastify": "5.12.5",
    "pino": "10.3.1",
    "undici": "8.11.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.15"
  }
}
