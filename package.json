{
  "name": "orbisyn",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "Self-hostable ecosystem manager for open-source software: resolve any upstream source into one canonical app record.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*",
    "tooling/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n gateway,web -c cyan,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev --workspace @orbisyn/web",
    "dev:api": "npm run dev --workspace @orbisyn/gateway",
    "build": "npm run build --workspace @orbisyn/gateway && npm run build --workspace @orbisyn/web",
    "start": "npm run start --workspace @orbisyn/gateway",
    "verify:native": "node scripts/verify-native-targets.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run verify:native && npm run lint && npm run typecheck && npm run test && npm run build",
    "selfhost": "npm run build && npm run start",
    "build:api": "npm run build --workspace @orbisyn/gateway",
    "build:web": "npm run build --workspace @orbisyn/web",
    "preview": "npm run build && npm run start",
    "preview:web": "npm run preview --workspace @orbisyn/web",
    "mobile:build": "npm run build --workspace @orbisyn/mobile",
    "mobile:open:ios": "npm run open:ios --workspace @orbisyn/mobile",
    "mobile:open:android": "npm run open:android --workspace @orbisyn/mobile",
    "mobile:run:ios": "npm run run:ios --workspace @orbisyn/mobile",
    "mobile:run:android": "npm run run:android --workspace @orbisyn/mobile",
    "desktop:dev": "npm run dev --workspace @orbisyn/desktop",
    "desktop:build": "npm run build --workspace @orbisyn/desktop"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "concurrently": "^9.2.1",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
